# Copy this file to `.env` in this same directory and fill in real values.
# `.env` is gitignored — never commit real credentials.

# Only needed when this isn't a fresh local WAMP setup (which defaults to
# host=localhost, db=wambely_api, user=root, no password). A real
# deployment (e.g. Hostinger) sets all four to its own MySQL credentials.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# stub  -> deterministic local fake data, no Nium credentials needed at all.
# nium  -> real Nium API calls, requires everything below to be filled in.
MONEY_TRANSFER_PROVIDER=stub

# sandbox | production — selects which base URL + credential pair below is used.
# Only relevant when MONEY_TRANSFER_PROVIDER=nium.
NIUM_ENV=sandbox

# From Nium Portal > Configuration > API keys. Sandbox and production each
# have their own base URL and their own key/clientHashId pair — confirm the
# exact sandbox host from the portal before filling this in (do not assume
# it matches the production gateway host).
NIUM_SANDBOX_BASE_URL=
NIUM_PRODUCTION_BASE_URL=

NIUM_CLIENT_HASH_ID=
NIUM_API_KEY=

# Used to verify inbound webhook calls actually came from Nium (exact
# verification mechanism confirmed from Nium Portal docs before webhooks/nium.php
# is wired up).
NIUM_WEBHOOK_SECRET=

# Google Sign-In: the Web OAuth Client ID from Google Cloud Console
# (console.cloud.google.com -> APIs & Services -> Credentials). Must match
# the client_id the Flutter app uses (web/index.html's
# google-signin-client_id meta tag) — the backend checks the Google ID
# token's `aud` claim against this value. Not a secret, but still keep it
# out of source control here for consistency with everything else in this file.
GOOGLE_CLIENT_ID=
